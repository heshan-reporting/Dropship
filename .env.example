# Every source is optional. Adapters without credentials are skipped at runtime,
# so the engine runs with whatever subset you have signed up for.

# --- CJ Dropshipping -------------------------------------------------------
# developers.cjdropshipping.com → API key is generated in your account settings.
# Free. Note: token minting is rate-limited to ~1 per 5 minutes.
CJ_EMAIL=
CJ_API_KEY=

# --- AliExpress Open Platform (DS API) -------------------------------------
# openservice.aliexpress.com → create an app, request dropshipping scope.
# Approval takes a few days. Tracking ID is your affiliate/portal id.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Printify --------------------------------------------------------------
# printify.com → Account → Connections → Personal access token. Free.
PRINTIFY_API_TOKEN=

# --- Bright Data (scrape fallback only) ------------------------------------
# Paid, per-request. Only used when an API adapter is unconfigured or failing.
# Leave blank to disable scraping entirely.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
