# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Any Postgres URL. Neon (neon.tech) and Supabase both have free tiers that
# work with Vercel out of the box. Run `npm run db:push` after setting this.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin access (required)
# ---------------------------------------------------------------------------
# The admin area refuses to open until this is set. Use something long.
ADMIN_PASSWORD=
# Optional: separate signing key for session cookies. Defaults to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Payments (required to take orders)
# ---------------------------------------------------------------------------
# dashboard.stripe.com/apikeys — use the test keys until you are ready.
STRIPE_SECRET_KEY=
# Created when you add the webhook endpoint, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Absolute URL Stripe redirects back to. Vercel sets this automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fulfilment
# ---------------------------------------------------------------------------
# printify.com → Account → Connections → Personal access token. Free.
PRINTIFY_API_TOKEN=
# GET https://api.printify.com/v1/shops.json with that token to find the id.
PRINTIFY_SHOP_ID=

# ---------------------------------------------------------------------------
# Product sourcing (optional — the engine skips whatever is unset)
# ---------------------------------------------------------------------------
CJ_EMAIL=
CJ_API_KEY=

ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Paid, per-request. Only used when an API adapter is unconfigured or failing.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
