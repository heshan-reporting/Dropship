{
  "name": "dropship-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-source product sourcing engine: API adapters with scrape fallback, normalized into one product schema.",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "search": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
